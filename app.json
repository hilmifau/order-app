{
  "expo": {
    "name": "Order App",
    "slug": "order-app",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/order-logo-new.png",
    "scheme": "order",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/f36efb6b-e0b5-48b8-9cc5-7fc4c3641d19",
      "enabled": true,
      "checkOnLaunch": "ALWAYS",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hilmifau.orderapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD700",
        "foregroundImage": "./assets/images/order-logo-new.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hilmifau.orderapp",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/order-logo-new.png",
      "title": "Order App"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/order-logo-new.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFD700"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f36efb6b-e0b5-48b8-9cc5-7fc4c3641d19"
      }
    }
  }
}