{
  "expo": {
    "name": "PO NARI PDA",
    "slug": "order-app",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/po_nari_pda_icon.png",
    "scheme": "order",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/f36efb6b-e0b5-48b8-9cc5-7fc4c3641d19",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hilmifau.orderapp",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/po_nari_pda_adaptive_fg.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hilmifau.orderapp",
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/po_nari_pda_icon.png",
      "title": "PO NARI PDA"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/po_nari_pda_splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f36efb6b-e0b5-48b8-9cc5-7fc4c3641d19"
      }
    }
  }
}
