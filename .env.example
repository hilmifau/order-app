# Backend API Base URL (Harus diakhiri /api)
# Contoh development lokal: http://localhost:8000/api atau http://192.168.1.xxx:8000/api
# Contoh production: https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Mode Mock Data (true: gunakan offline dummy data, false: gunakan API backend riil)
EXPO_PUBLIC_USE_MOCK_DATA=false

